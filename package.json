{
  "name": "d-board",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=@d-board/api",
    "build:web": "npm run build --workspace=web",
    "build:api": "npm run build --workspace=@d-board/api",
    "typecheck:api": "npm run typecheck --workspace=@d-board/api",
    "typecheck:web": "npm run build --workspace=web",
    "test:api": "npm run test --workspace=@d-board/api",
    "test:web": "npm run test --workspace=web",
    "test:e2e": "npx tsx e2e/e2e_smoke_suite.ts",
    "test": "npm run test:api && npm run test:web && npm run test:e2e",
    "audit": "node scripts/audit-check.mjs"
  }
}