# ==============================================================================
# D-Board Monorepo Environment Configuration (.env.example)
# ==============================================================================
# D-Board is organized as an npm workspaces monorepo:
# - Backend API: apps/api/.env (see apps/api/.env.example)
# - Frontend Web SPA: apps/web/.env (see apps/web/.env.example)
# - Provider Connectivity Verification: .env.providers-test (see .env.providers-test.example)
#
# Copy this file or the respective workspace files:
#   cp apps/api/.env.example apps/api/.env
#   cp apps/web/.env.example apps/web/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API (apps/api/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5000
COOKIE_SAME_SITE=lax
ENABLE_EMBEDDED_WORKER=true

# Database (PostgreSQL - Supabase / Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/d_board?schema=public

# Redis (Render Key Value / Valkey / Local)
REDIS_URL=redis://localhost:6379

# Object Storage (Cloudflare R2 / S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=d-board-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Transactional Email (Brevo HTTPS API & SMTP fallback)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="D-Board" <verified-sender@yourdomain.com>

# Security
JWT_SECRET=replace_with_a_secure_cryptographic_random_string_min_32_chars

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 2. Frontend Web SPA (apps/web/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=/api
VITE_ENABLE_GOOGLE_AUTH=false
