# ==============================================================================
# D-Board Remote Provider Connectivity Test Environment (.env.providers-test)
# ==============================================================================
# This file is used exclusively by the provider verification script (scripts/verify-providers.ts).
# Do NOT commit this file with real credentials.

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL (Session Pooler port 5432)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Render Key Value / Valkey
# ------------------------------------------------------------------------------
# Example: redis://red-xxxxxxxx:6379 or rediss://default:token@host:port
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 (S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=d-board-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# 4. Brevo SMTP (Transactional Email)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="D-Board <noreply@yourdomain.com>"
# Safe recipient email address for sending a single verification message:
TEST_EMAIL=

# ------------------------------------------------------------------------------
# 5. Security & Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=d-board-provider-test-jwt-secret-key-32chars!
