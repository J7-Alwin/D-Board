# ==============================================================================
# D-Board API Environment Configuration (.env.example)
# Target Free Infrastructure: Supabase, Render Key Value / Valkey, Cloudflare R2, Brevo, Render
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend Web Origin URL (used for CORS and redirect destinations)
# In production on Render, set to your Render Static Site URL:
# CLIENT_URL=https://d-board.onrender.com
CLIENT_URL=http://localhost:5173

# API Base URL (used for OAuth redirects and canonical links)
# In production on Render, set to your Render Web Service URL:
# APP_URL=https://d-board-api.onrender.com
APP_URL=http://localhost:5000

# Cross-Site Cookie Policy (Render uses separate onrender.com subdomains)
# Use 'none' for Render cross-origin deployment; 'lax' for local development or custom domains
COOKIE_SAME_SITE=lax

# Embedded BullMQ Worker (Run API + BullMQ Worker in same Render Web Service container)
# Default is true. Set to 'false' if running worker as a separate standalone process.
ENABLE_EMBEDDED_WORKER=true

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/d_board?schema=public

# Free Supabase Deployment:
# In Render production (persistent Express API -> Prisma), use the Supabase Session Pooler connection on port 5432:
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Set to 'true' to explicitly force TLS on database connection:
# DATABASE_SSL=true

# ------------------------------------------------------------------------------
# 3. Redis (Cache, Sessions, Rate Limiting, BullMQ Queues)
# ------------------------------------------------------------------------------
# Local Development:
REDIS_URL=redis://localhost:6379

# Render Key Value / Valkey Deployment:
# Use the internal redis:// or rediss:// connection string from Render Key Value:
# REDIS_URL=redis://red-xxxxxxxx:6379

# ------------------------------------------------------------------------------
# 4. Object Storage (Cloudflare R2 / S3-Compatible)
# ------------------------------------------------------------------------------
# STORAGE_DRIVER: 'local' for development, 's3' for Cloudflare R2 or AWS S3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=

# Provider-Neutral S3 / Cloudflare R2 Configuration (Required when STORAGE_DRIVER=s3)
# For Cloudflare R2:
# S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=d-board-files
# S3_ACCESS_KEY_ID=<r2-token-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-token-secret-access-key>
# S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=d-board-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Legacy AWS_* variable fallbacks (Supported for backward compatibility)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 5. Email Dispatch (Brevo SMTP / Generic SMTP)
# ------------------------------------------------------------------------------
# Local Development / Mailtrap:
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASSWORD=your_smtp_password

# Free Brevo SMTP Deployment:
# Host: smtp-relay.brevo.com
# Port: 587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="D-Board" <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# 6. Security & Authentication
# ------------------------------------------------------------------------------
# JWT Secret (MUST be at least 32 characters in production)
JWT_SECRET=replace_with_a_secure_cryptographic_random_string_min_32_chars

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# In production on Render:
# GOOGLE_CALLBACK_URL=https://<your-render-api-service>.onrender.com/api/auth/google/callback