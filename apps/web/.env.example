# ==============================================================================
# D-Board Web Frontend Environment Configuration (.env.example)
# ==============================================================================
# In production on Render Static Sites, configure this variable in the Render Dashboard:
# VITE_API_URL=https://<your-render-api-service>.onrender.com
#
# In local development, leave empty or set to /api (uses Vite proxy to backend)
VITE_API_URL=/api
